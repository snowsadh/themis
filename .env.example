# Copy to .env in the repository root. Never put secrets in VITE_ variables.
# OpenAI-compatible server serving your fine-tuned model; include /v1, not /chat/completions.
THEMIS_BASE_URL=
THEMIS_MODEL=
THEMIS_API_KEY=

# Optional fallback. Used only if enabled and the primary fails/is absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# A general instruction model for opposing counsel (the judge adapter is a scorer).
COUNSEL_BASE_URL=
COUNSEL_MODEL=
COUNSEL_API_KEY=

# Optional legacy OpenRouter configuration is still supported.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Inference timeout for local/custom providers (5–120 seconds). OpenAI uses 45 seconds.
MODEL_TIMEOUT_SECONDS=90
